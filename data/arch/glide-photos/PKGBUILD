pkgname=glide-photos
pkgver=0.1.r0.g0000000
pkgrel=1
pkgdesc="Photo library and viewer of the Glide desktop"
arch=(x86_64)
url="https://github.com/Glide-Desktop/glide-photos"
license=(GPL-3.0-or-later)
depends=(
    glibc gcc-libs libglvnd vulkan-icd-loader wayland libxkbcommon hicolor-icon-theme
    glide-configd dbus xdg-utils
    libheif libjxl imagemagick ghostscript udisks2
)
makedepends=(git cargo pkgconf)
options=(!lto !debug)
_git="${GLIDE_GIT:-https://github.com/Glide-Desktop}"
_target="${GLIDE_CARGO_TARGET:-target}"
source=("$pkgname::git+$_git/glide-photos.git")
sha256sums=('SKIP')

pkgver() {
    cd "$pkgname"
    printf '0.1.r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
    cd "$pkgname"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$pkgname"
    export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR="$_target"
    cargo build --frozen --release -p glide-photos
}

package() {
    cd "$pkgname"
    install -Dm755 $_target/release/glide-photos "$pkgdir/usr/bin/glide-photos"
    install -Dm644 data/glide-photos.desktop "$pkgdir/usr/share/applications/glide-photos.desktop"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
